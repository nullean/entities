<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- Discriminated unions (`readonly union Name(Case1, Case2, ...);`) only parse under
         LangVersion=preview in the installed 11.0.100-preview.7 SDK — `latest` resolves to the
         stable C# version that ships with it and rejects `union` with CS1001. Scoped to net11.0
         only: net10.0 stays on `latest` so nothing there silently starts accepting other preview
         syntax it was never exercised against. -->
    <LangVersion Condition="'$(TargetFramework)' == 'net11.0'">preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
    <SolutionRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), build.sh))</SolutionRoot>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <MinVerDefaultPreReleaseIdentifiers>canary.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!-- src/ projects: packable, documented, signed -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/src/'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- None of these libraries have XML doc comments yet (checkpoint-A exploration code).
         One project-wide NoWarn beats a `#pragma warning disable CS1591` repeated at the top
         of every file — see tests/Directory.Build.props, which already does the same for tests. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The core and Reactive packages are trim/AOT clean (the analyzers run on every build, and
         tests/Nullean.Entities.AotSmoke publishes them NativeAOT). The CsCheck packages and the source
         generator are not: AutoGen, Bogus and AutoBogus rely on reflection. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsAotCompatible Condition="'$(MSBuildProjectName)' == 'Nullean.Entities' Or '$(MSBuildProjectName)' == 'Nullean.Entities.Reactive'">true</IsAotCompatible>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build/keys/keypair.snk</AssemblyOriginatorKeyFile>
    <Authors>Nullean and contributors</Authors>
    <Copyright>Nullean</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nullean/entities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nullean/entities</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- PackageIcon/PackageReadmeFile above only name the files; NuGet still needs them added to the
       package explicitly. Unlike curb (one product, one README repeated into every package), each
       package here is independently installable and covers a genuinely different surface, so each
       gets its own README.md living next to its .csproj — package-specific, not the repo-wide one. -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/src/'))">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)nuget-icon.png" Pack="true" PackagePath="nuget-icon.png" />
  </ItemGroup>

  <!-- tests/ projects -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/tests/'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

  <!-- examples/ projects. TreatWarningsAsErrors stays true (inherited from the root
       PropertyGroup) on purpose: example code is real code, held to the same bar. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/examples/'))">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>
</Project>
