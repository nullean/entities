<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Reactive temporal constraints over IObservable streams for live monitoring and property testing.</Description>
    <PackageTags>reactive temporal constraints monitoring specification</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reactive" />
    <ProjectReference Include="../../src/Nullean.Entities/Nullean.Entities.csproj" />
    <!-- Dev-time only, same reasoning as Nullean.Entities.csproj: makes [Constraint] on a
         ReactiveConstraint<T> member work when compiling this project's own code/tests/examples.
         Not packed again here — a consumer gets the generator transitively through the
         Nullean.Entities dependency above, whose package already embeds it. -->
    <ProjectReference Include="../Nullean.Entities.SourceGenerators/Nullean.Entities.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
