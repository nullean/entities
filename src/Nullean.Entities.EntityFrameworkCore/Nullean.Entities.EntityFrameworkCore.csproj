<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Checks Nullean.Entities constraint sets on SaveChanges: added entities are validated, modified ones are checked against EF Core's original values, and a violation throws before anything is written.</Description>
    <PackageTags>constraints validation entity-framework efcore savechanges interceptor</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <ProjectReference Include="../../src/Nullean.Entities/Nullean.Entities.csproj" />
  </ItemGroup>
</Project>
