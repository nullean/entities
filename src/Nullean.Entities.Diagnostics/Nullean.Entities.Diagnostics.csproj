<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Turns Nullean.Entities violations seen at runtime (rejected changes, missed temporal deadlines) into structured logs, System.Diagnostics.Metrics counters and Activity events that OpenTelemetry or any other listener picks up by name. No OpenTelemetry dependency.</Description>
    <PackageTags>constraints validation logging metrics diagnostics opentelemetry</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../../src/Nullean.Entities/Nullean.Entities.csproj" />
  </ItemGroup>
</Project>
