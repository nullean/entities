<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Domain entity constraints: named rules, violation reporting, and safe mutation via Result&lt;T&gt;.</Description>
    <PackageTags>domain entities constraints validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev-time only: makes the [Constraint] generator run on this project's own compilation.
         ReferenceOutputAssembly=false keeps the generator's netstandard2.0 assembly out of this
         package's dependency list entirely; it ships as an analyzer, not a reference. -->
    <ProjectReference Include="../Nullean.Entities.SourceGenerators/Nullean.Entities.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Packs the generator's own DLL into this package under analyzers/dotnet/cs. A consumer who
       installs Nullean.Entities (or anything that depends on it, since NuGet analyzer assets flow
       transitively through PackageReference) gets [Constraint] support without a separate install.
       The path is asked of the generator project itself. Reading @(Analyzer) (what OutputItemType="Analyzer"
       fills in) does not work here: this project is multi-targeted, packing runs in the outer build, and the
       outer build has no @(Analyzer) at all, so the package shipped without the generator (0.1.0-preview.1). -->
  <Target Name="PackConstraintGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Nullean.Entities.SourceGenerators/Nullean.Entities.SourceGenerators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ConstraintGeneratorDll" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(ConstraintGeneratorDll)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
