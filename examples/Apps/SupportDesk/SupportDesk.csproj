<Project Sdk="Microsoft.NET.Sdk">
  <!-- A support desk on virtual time: a ticket lifecycle declared as a value state machine with a timeout, a service on a TimeProvider,
       an SLA rule watched live and audited afterwards, and a sweeper that closes what has sat resolved for three days. `dotnet run`,
       or `./build.sh apps`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>SupportDesk</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <Compile Include="../Shared/Narrator.cs" Link="Narrator.cs" />
    <ProjectReference Include="../../../src/Nullean.Entities/Nullean.Entities.csproj" />
  </ItemGroup>
</Project>
