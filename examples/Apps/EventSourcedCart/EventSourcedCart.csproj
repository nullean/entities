<Project Sdk="Microsoft.NET.Sdk">
  <!-- A shopping cart as an event-sourced aggregate: pure decide and evolve functions, an in-memory event store with optimistic concurrency,
       and rules checked on the events a command would produce before anything is appended. `dotnet run`, or `./build.sh apps`.
       The tests explore every reachable cart exhaustively (EntitySpec.EventSourced). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>EventSourcedCart</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <Compile Include="../Shared/Narrator.cs" Link="Narrator.cs" />
    <ProjectReference Include="../../../src/Nullean.Entities/Nullean.Entities.csproj" />
  </ItemGroup>
</Project>
