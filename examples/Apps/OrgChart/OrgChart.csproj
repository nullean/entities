<Project Sdk="Microsoft.NET.Sdk">
  <!-- A reporting hierarchy held as a nested tree. Hire, move and terminate are tree surgery; the rules over every node of the tree, and a rule per kind
       of edit, are what keep it a hierarchy. `dotnet run`, or `./build.sh apps`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>OrgChart</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <Compile Include="../Shared/Narrator.cs" Link="Narrator.cs" />
    <ProjectReference Include="../../../src/Nullean.Entities/Nullean.Entities.csproj" />
  </ItemGroup>
</Project>
